#!/bin/bash -e

ROOT=$(dirname "$(readlink -f "$0")")

export QT_QPA_PLATFORM=wayland
export QT_QPA_PLATFORM_PLUGIN_PATH=/usr/lib/qt/plugins/platforms

# Set full Python path so launcher.py and tests can find all modules
# regardless of how __file__ is resolved at runtime
export PYTHONPATH=$ROOT/common/factorytest:$ROOT/cricket:$ROOT:$ROOT/tests:$PYTHONPATH

exec python3 $ROOT/common/factorytest/launcher.py
